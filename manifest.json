{
  "manifest_version": 3,
  "name": "Docs to Markdown",
  "version": "0.1.0",
  "description": "Copy the current documentation page as clean Markdown.",
  "permissions": [
    "activeTab",
    "contextMenus",
    "scripting",
    "storage"
  ],
  "action": {
    "default_title": "Docs to Markdown",
    "default_popup": "popup/popup.html"
  },
  "background": {
    "service_worker": "background/service-worker.js",
    "type": "module"
  },
  "options_page": "options/options.html"
}
