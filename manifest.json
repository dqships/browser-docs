{
  "manifest_version": 3,
  "name": "WebToMarkdown",
  "version": "1.1.0",
  "description": "Copy the current documentation page as clean Markdown.",
  "permissions": [
    "activeTab",
    "clipboardWrite",
    "contextMenus",
    "scripting",
    "storage"
  ],
  "action": {
    "default_title": "WebToMarkdown",
    "default_popup": "popup/popup.html"
  },
  "icons": {
    "16": "shared/icons/icon-16.png",
    "32": "shared/icons/icon-32.png",
    "48": "shared/icons/icon-48.png",
    "128": "shared/icons/icon-128.png"
  },
  "background": {
    "service_worker": "background/service-worker.js",
    "type": "module"
  },
  "options_page": "options/options.html",
  "commands": {
    "copy_markdown": {
      "suggested_key": {
        "default": "Alt+Shift+M",
        "mac": "Alt+Shift+M"
      },
      "description": "Copy as Markdown"
    },
    "download_markdown": {
      "description": "Download as Markdown"
    }
  }
}