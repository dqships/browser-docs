{
  "manifest_version": 3,
  "name": "Web to Markdown",
  "version": "1.0.0",
  "description": "Copy the current documentation page as clean Markdown.",
  "permissions": [
    "activeTab",
    "clipboardWrite",
    "contextMenus",
    "scripting",
    "storage"
  ],
  "action": {
    "default_title": "Web to Markdown",
    "default_popup": "popup/popup.html"
  },
  "icons": {
    "16": "shared/icon.png",
    "48": "shared/icon.png",
    "128": "shared/icon.png"
  },
  "background": {
    "service_worker": "background/service-worker.js",
    "type": "module"
  },
  "options_page": "options/options.html"
}